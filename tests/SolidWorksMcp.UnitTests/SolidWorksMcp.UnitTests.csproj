<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline tests: no SOLIDWORKS needed to build or run (CI). The interop-free Core files are compiled in as linked
       sources, so this project never references the SolidWorks interop assemblies. If one of these files starts using
       SolidWorks types, this build breaks — on purpose. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SolidWorksMcp.UnitTests</RootNamespace>
    <NoWarn>$(NoWarn);CA1416;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\SolidWorksMcp.Core\GlobalUsings.cs" Link="Core\GlobalUsings.cs" />
    <Compile Include="..\..\src\SolidWorksMcp.Core\SwException.cs" Link="Core\SwException.cs" />
    <Compile Include="..\..\src\SolidWorksMcp.Core\SwOptions.cs" Link="Core\SwOptions.cs" />
    <Compile Include="..\..\src\SolidWorksMcp.Core\Com\ComArgs.cs" Link="Core\Com\ComArgs.cs" />
