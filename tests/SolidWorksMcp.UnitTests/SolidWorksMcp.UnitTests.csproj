    <Compile Include="..\..\src\SolidWorksMcp.Core\Files\PathPolicy.cs" Link="Core\Files\PathPolicy.cs" />
    <Compile Include="..\..\src\SolidWorksMcp.Core\Geometry\AxisSpec.cs" Link="Core\Geometry\AxisSpec.cs" />
    <Compile Include="..\..\src\SolidWorksMcp.Core\Geometry\ResolvedInfo.cs" Link="Core\Geometry\ResolvedInfo.cs" />
