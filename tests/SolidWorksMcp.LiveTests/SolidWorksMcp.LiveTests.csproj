<Project Sdk="Microsoft.NET.Sdk">

  <!-- Needs a SOLIDWORKS installation to build (it references Core). The catalog/interop contract tests always run;
       the live tests run only with SWMCP_LIVE_TESTS=1 and then FAIL (not skip) if SOLIDWORKS can't be attached. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SolidWorksMcp.LiveTests</RootNamespace>
    <NoWarn>$(NoWarn);CA1416;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SolidWorksMcp.Core\SolidWorksMcp.Core.csproj" />
    <ProjectReference Include="..\..\src\SolidWorksMcp.Server\SolidWorksMcp.Server.csproj" />
  </ItemGroup>

</Project>
